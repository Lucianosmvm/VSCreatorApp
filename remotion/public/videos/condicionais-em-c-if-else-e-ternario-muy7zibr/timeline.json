050.wav"}, {"inicio": 241.463, "dur": 4.552, "janela": 0.25, "texto": "Mas esse assunto merece um vídeo só dele. Comenta switch aí embaixo se você quer a parte 2.", "palavras": [{"w": "Mas", "t": 0}, {"w": "esse", "t": 0.209}, {"w": "assunto", "t": 0.349}, {"w": "merece", "t": 0.767}, {"w": "um", "t": 1.092}, {"w": "vídeo", "t": 1.184}, {"w": "só", "t": 1.463}, {"w": "dele.", "t": 1.673}, {"w": "Comenta", "t": 2.241}, {"w": "switch", "t": 2.625}, {"w": "aí", "t": 2.926}, {"w": "embaixo", "t": 3.019}, {"w": "se", "t": 3.414}, {"w": "você", "t": 3.495}, {"w": "quer", "t": 3.739}, {"w": "a", "t": 3.867}, {"w": "parte", "t": 3.936}, {"w": "2.", "t": 4.25}], "mascote": "determinado", "titulo": "Parte 2?", "audio": "cena_051.wav"}, {"inicio": 246.015, "dur": 5.073, "janela": 0.25, "texto": "Hora do desafio. Uma nota 6 com o teste de maior ou igual a 5 vindo primeiro. Qual resultado aparece?", "palavras": [{"w": "Hora", "t": 0}, {"w": "do", "t": 0.22}, {"w": "desafio.", "t": 0.325}, {"w": "Uma", "t": 0.801}, {"w": "nota", "t": 0.952}, {"w": "6", "t": 1.219}, {"w": "com", "t": 1.463}, {"w": "o", "t": 1.602}, {"w": "teste", "t": 1.648}, {"w": "de", "t": 1.927}, {"w": "maior", "t": 2.02}, {"w": "ou", "t": 2.461}, {"w": "igual", "t": 2.566}, {"w": "a", "t": 2.821}, {"w": "5", "t": 2.949}, {"w": "vindo", "t": 3.227}, {"w": "primeiro.", "t": 3.448}, {"w": "Qual", "t": 3.924}, {"w": "resultado", "t": 4.121}, {"w": "aparece?", "t": 4.539}], "mascote": "determinado", "titulo": "Desafio", "audio": "cena_052.wav"}, {"inicio": 251.088, "dur": 3.472, "janela": 0.25, "texto": "Pensa aí e responde nos comentários. Eu vou fixar quem acertar.", "palavras": [{"w": "Pensa", "t": 0}, {"w": "aí", "t": 0.325}, {"w": "e", "t": 0.581}, {"w": "responde", "t": 0.697}, {"w": "nos", "t": 1.115}, {"w": "comentários.", "t": 1.254}, {"w": "Eu", "t": 1.997}, {"w": "vou", "t": 2.148}, {"w": "fixar", "t": 2.288}, {"w": "quem", "t": 2.729}, {"w": "acertar.", "t": 2.926}], "mascote": "feliz", "audio": "cena_053.wav"}, {"inicio": 254.56, "dur": 5.26, "janela": 0.25, "texto": "Recapitulando: if testa, else oferece a alternativa, else if encadeia, e o ternário resume.", "palavras": [{"w": "Recapitulando:", "t": 0}, {"w": "if", "t": 0.801}, {"w": "testa,", "t": 1.022}, {"w": "else", "t": 1.533}, {"w": "oferece", "t": 1.904}, {"w": "a", "t": 2.334}, {"w": "alternativa,", "t": 2.427}, {"w": "else", "t": 3.251}, {"w": "if", "t": 3.588}, {"w": "encadeia,", "t": 3.785}, {"w": "e", "t": 4.273}, {"w": "o", "t": 4.342}, {"w": "ternário", "t": 4.424}, {"w": "resume.", "t": 4.772}], "mascote": "frente", "titulo": "Resumo", "audio": "cena_054.wav"}, {"inicio": 259.82, "dur": 5.12, "janela": 0.25, "texto": "Se esse vídeo te ajudou, deixa o like, salva pra revisar e me segue pra mais C sharp sem enrolação!", "palavras": [{"w": "Se", "t": 0}, {"w": "esse", "t": 0.127}, {"w": "vídeo", "t": 0.325}, {"w": "te", "t": 0.58}, {"w": "ajudou,", "t": 0.661}, {"w": "deixa", "t": 1.102}, {"w": "o", "t": 1.381}, {"w": "like,", "t": 1.462}, {"w": "salva", "t": 1.846}, {"w": "pra", "t": 2.171}, {"w": "revisar", "t": 2.298}, {"w": "e", "t": 2.728}, {"w": "me", "t": 2.844}, {"w": "segue", "t": 2.972}, {"w": "pra", "t": 3.274}, {"w": "mais", "t": 3.436}, {"w": "C", "t": 3.633}, {"w": "sharp", "t": 3.819}, {"w": "sem", "t": 4.202}, {"w": "enrolação!", "t": 4.423}], "mascote": "feliz", "titulo": "Segue aí", "audio": "cena_055.wav"}]}