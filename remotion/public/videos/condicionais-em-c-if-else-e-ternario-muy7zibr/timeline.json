er entre dois valores de forma rápida.", "palavras": [{"w": "Então,", "t": 0}, {"w": "quando", "t": 0.58}, {"w": "usar", "t": 0.824}, {"w": "cada", "t": 1.033}, {"w": "um?", "t": 1.253}, {"w": "Use", "t": 1.428}, {"w": "o", "t": 1.637}, {"w": "ternário", "t": 1.706}, {"w": "pra", "t": 2.113}, {"w": "escolher", "t": 2.252}, {"w": "entre", "t": 2.647}, {"w": "dois", "t": 2.902}, {"w": "valores", "t": 3.111}, {"w": "de", "t": 3.471}, {"w": "forma", "t": 3.587}, {"w": "rápida.", "t": 3.854}], "mascote": "frente", "titulo": "Quando usar cada um", "audio": "cena_042.wav"}, {"inicio": 202.895, "dur": 5.77, "janela": 0.25, "texto": "Use if e else quando tiver ações, várias linhas ou lógica mais complexa. Legibilidade vem primeiro.", "palavras": [{"w": "Use", "t": 0}, {"w": "if", "t": 0.395}, {"w": "e", "t": 0.731}, {"w": "else", "t": 0.94}, {"w": "quando", "t": 1.219}, {"w": "tiver", "t": 1.463}, {"w": "ações,", "t": 1.753}, {"w": "várias", "t": 2.287}, {"w": "linhas", "t": 2.67}, {"w": "ou", "t": 3.042}, {"w": "lógica", "t": 3.216}, {"w": "mais", "t": 3.622}, {"w": "complexa.", "t": 3.785}, {"w": "Legibilidade", "t": 4.458}, {"w": "vem", "t": 5.19}, {"w": "primeiro.", "t": 5.329}], "mascote": "neutro", "audio": "cena_043.wav"}, {"inicio": 208.665, "dur": 3.994, "janela": 0.25, "texto": "Bônus pra quem chegou até aqui: dois primos do ternário que vão limpar muito o seu código.", "palavras": [{"w": "Bônus", "t": 0}, {"w": "pra", "t": 0.337}, {"w": "quem", "t": 0.488}, {"w": "chegou", "t": 0.65}, {"w": "até", "t": 0.917}, {"w": "aqui:", "t": 1.08}, {"w": "dois", "t": 1.486}, {"w": "primos", "t": 1.742}, {"w": "do", "t": 2.043}, {"w": "ternário", "t": 2.136}, {"w": "que", "t": 2.543}, {"w": "vão", "t": 2.647}, {"w": "limpar", "t": 2.775}, {"w": "muito", "t": 3.053}, {"w": "o", "t": 3.286}, {"w": "seu", "t": 3.367}, {"w": "código.", "t": 3.529}], "mascote": "feliz", "titulo": "Bônus", "audio": "cena_044.wav"}, {"inicio": 212.659, "dur": 3.587, "janela": 0.25, "texto": "O primeiro é o operador de coalescência nula: duas interrogações seguidas.", "palavras": [{"w": "O", "t": 0}, {"w": "primeiro", "t": 0.139}, {"w": "é", "t": 0.534}, {"w": "o", "t": 0.627}, {"w": "operador", "t": 0.673}, {"w": "de", "t": 1.114}, {"w": "coalescência", "t": 1.219}, {"w": "nula:", "t": 1.823}, {"w": "duas", "t": 2.148}, {"w": "interrogações", "t": 2.415}, {"w": "seguidas.", "t": 3.007}], "mascote": "frente", "titulo": "Duas interrogações", "audio": "cena_045.wav"}, {"inicio": 216.246, "dur": 4.006, "janela": 0.25, "texto": "Ele devolve o valor da esquerda se não for nulo. Se for nulo, usa o valor da direita.", "palavras": [{"w": "Ele", "t": 0}, {"w": "devolve", "t": 0.221}, {"w": "o", "t": 0.581}, {"w": "valor", "t": 0.639}, {"w": "da", "t": 0.918}, {"w": "esquerda", "t": 0.987}, {"w": "se", "t": 1.417}, {"w": "não", "t": 1.533}, {"w": "for", "t": 1.672}, {"w": "nulo.", "t": 1.87}, {"w": "Se", "t": 2.218}, {"w": "for", "t": 2.392}, {"w": "nulo,", "t": 2.578}, {"w": "usa", "t": 2.891}, {"w": "o", "t": 3.112}, {"w": "valor", "t": 3.17}, {"w": "da", "t": 3.449}, {"w": "direita.", "t": 3.553}], "mascote": "neutro", "audio": "cena_046.wav"}, {"inicio": 220.252, "dur": 6.142, "janela": 0.25, "texto": "Tipo: o nome recebe o nome do usuário ou, se ele estiver vazio, a palavra visitante. Uma linha, sem if.", "palavras": [{"w": "Tipo:", "t": 0}, {"w": "o", "t": 0.557}, {"w": "nome", "t": 0.65}, {"w": "recebe", "t": 0.859}, {"w": "o", "t": 1.207}, {"w": "nome", "t": 1.265}, {"w": "do", "t": 1.463}, {"w": "usuário", "t": 1.544}, {"w": "ou,", "t": 1.95}, {"w": "se", "t": 2.09}, {"w": "ele", "t": 2.183}, {"w": "estiver", "t": 2.299}, {"w": "vazio,", "t": 2.659}, {"w": "a", "t": 3.077}, {"w": "palavra", "t": 3.181}, {"w": "visitante.", "t": 3.564}, {"w": "Uma", "t": 4.539}, {"w": "linha,", "t": 4.783}, {"w": "sem", "t": 5.062}, {"w": "if.", "t": 5.352}], "mascote": "lado", "audio": "cena_047.wav"}, {"inicio": 226.394, "dur": 6.083, "janela": 0.25, "texto": "O segundo é a expr