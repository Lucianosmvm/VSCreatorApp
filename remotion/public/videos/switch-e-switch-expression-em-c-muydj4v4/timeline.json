", "t": 0.511}, {"w": "expression", "t": 0.825}, {"w": "quando", "t": 1.428}, {"w": "o", "t": 1.707}, {"w": "objetivo", "t": 1.858}, {"w": "é", "t": 2.496}, {"w": "transformar", "t": 2.554}, {"w": "um", "t": 3.111}, {"w": "valor", "t": 3.193}, {"w": "em", "t": 3.541}, {"w": "outro.", "t": 3.669}, {"w": "É", "t": 4.168}, {"w": "o", "t": 4.296}, {"w": "caso", "t": 4.377}, {"w": "mais", "t": 4.656}, {"w": "comum.", "t": 4.853}], "mascote": "comemorando", "titulo": "switch expression", "audio": "cena_040.wav"}, {"inicio": 189.787, "dur": 6.559, "janela": 0.25, "texto": "Regra de bolso: se cada case só faz uma atribuição ou um return, troque pela switch expression.", "palavras": [{"w": "Regra", "t": 0}, {"w": "de", "t": 0.302}, {"w": "bolso:", "t": 0.418}, {"w": "se", "t": 1.103}, {"w": "cada", "t": 1.277}, {"w": "case", "t": 1.567}, {"w": "só", "t": 1.927}, {"w": "faz", "t": 2.113}, {"w": "uma", "t": 2.403}, {"w": "atribuição", "t": 2.566}, {"w": "ou", "t": 3.343}, {"w": "um", "t": 3.494}, {"w": "return,", "t": 3.622}, {"w": "troque", "t": 4.446}, {"w": "pela", "t": 4.795}, {"w": "switch", "t": 5.05}, {"w": "expression.", "t": 5.491}], "mascote": "apontando", "titulo": "Regra de bolso", "audio": "cena_041.wav"}, {"inicio": 196.346, "dur": 8.406, "janela": 0.25, "texto": "Hora do desafio. Temperatura 30. Primeiro caso: maior que 20, morno. Segundo: maior que 28, quente.", "palavras": [{"w": "Hora", "t": 0}, {"w": "do", "t": 0.337}, {"w": "desafio.", "t": 0.453}, {"w": "Temperatura", "t": 1.254}, {"w": "30.", "t": 1.939}, {"w": "Primeiro", "t": 2.659}, {"w": "caso:", "t": 3.054}, {"w": "maior", "t": 3.541}, {"w": "que", "t": 3.878}, {"w": "20,", "t": 4.006}, {"w": "morno.", "t": 4.668}, {"w": "Segundo:", "t": 5.492}, {"w": "maior", "t": 6.153}, {"w": "que", "t": 6.467}, {"w": "28,", "t": 6.571}, {"w": "quente.", "t": 7.465}], "mascote": "determinado", "titulo": "Desafio", "audio": "cena_042.wav"}, {"inicio": 204.752, "dur": 5.398, "janela": 0.25, "texto": "Qual texto a sw