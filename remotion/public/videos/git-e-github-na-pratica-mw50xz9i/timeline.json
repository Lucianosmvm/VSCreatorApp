.", "t": 4.68}], "audio": "cena_010.wav"}, {"inicio": 52.88, "dur": 5.24, "janela": 0.25, "texto": "Dá pra usar Git sem GitHub. Mas o GitHub sem Git não faz sentido.", "palavras": [{"w": "Dá", "t": 0.0}, {"w": "pra", "t": 0.16}, {"w": "usar", "t": 0.32}, {"w": "Git", "t": 0.56}, {"w": "sem", "t": 1.04}, {"w": "GitHub.", "t": 1.44}, {"w": "Mas", "t": 2.16}, {"w": "o", "t": 2.28}, {"w": "GitHub", "t": 2.6}, {"w": "sem", "t": 2.96}, {"w": "Git", "t": 3.2}, {"w": "não", "t": 3.76}, {"w": "faz", "t": 4.0}, {"w": "sentido.", "t": 4.28}], "audio": "cena_011.wav"}, {"inicio": 58.12, "dur": 4.68, "janela": 0.25, "texto": "O Git foi criado em 2005 por Linus Torvalds, o mesmo criador do Linux.", "palavras": [{"w": "O", "t": 0.0}, {"w": "Git", "t": 0.12}, {"w": "foi", "t": 0.4}, {"w": "criado", "t": 0.6}, {"w": "em", "t": 0.88}, {"w": "2005", "t": 0.96}, {"w": "por", "t": 1.8}, {"w": "Linus", "t": 2.04}, {"w": "Torvalds,", "t": 2.44}, {"w": "o", "t": 3.12}, {"w": "mesmo", "t": 3.24}, {"w": "criador", "t": 3.56}, {"w": "do", "t": 3.92}, {"w": "Linux.", "t": 4.04}], "audio": "cena_012.wav"}, {"inicio": 62.8, "dur": 3.44, "janela": 0.25, "texto": "Hoje ele é o controle de versão mais usado do mundo.", "palavras": [{"w": "Hoje", "t": 0.0}, {"w": "ele", "t": 0.48}, {"w": "é", "t": 0.64}, {"w": "o", "t": 0.693}, {"w": "controle", "t": 0.8}, {"w": "de", "t": 1.2}, {"w": "versão", "t": 1.4}, {"w": "mais", "t": 1.84}, {"w": "usado", "t": 2.16}, {"w": "do", "t": 2.56}, {"w": "mundo.", "t": 2.72}], "audio": "cena_013.wav"}, {"inicio": 66.24, "dur": 4.72, "janela": 0.25, "texto": "Ele é gratuito, de código aberto, e funciona no Windows, no Linux e no Mac.", "palavras": [{"w": "Ele", "t": 0.0}, {"w": "é", "t": 0.16}, {"w": "gratuito,", "t": 0.213}, {"w": "de", "t": 0.92}, {"w": "código", "t": 1.04}, {"w": "aberto,", "t": 1.44}, {"w": "e", "t": 1.96}, {"w": "funciona", "t": 2.12}, {"w": "no", "t": 2.48}, {"w": "Windows,", "t": 2.64}, {"w": "no", "t": 3.16}, {"w": "Linux", "t": 3.28}, {"w": "e", "t": 3.76}, {"w": "no", "t": 3.88}, {"w": "Mac.", "t": 4.12}], "audio": "cena_014.wav"}, {"inicio": 70.96, "dur": 5.04, "janela": 0.25, "texto": "Pra começar, você abre o terminal na pasta do projeto e digita git init.", "palavras": [{"w": "Pra", "t": 0.0}, {"w": "começar,", "t": 0.16}, {"w": "você", "t": 0.84}, {"w": "abre", "t": 1.12}, {"w": "o", "t": 1.32}, {"w": "terminal", "t": 1.56}, {"w": "na", "t": 1.84}, {"w": "pasta", "t": 2.0}, {"w": "do", "t": 2.28}, {"w": "projeto", "t": 2.44}, {"w": "e", "t": 2.96}, {"w": "digita", "t": 3.16}, {"w": "git", "t": 3.68}, {"w": "init.", "t": 4.16}], "audio": "cena_015.wav"}, {"inicio": 76.0, "dur": 4.48, "janela": 0.25, "texto": "Pronto. A pasta virou um repositório, e o Git começa a observar tudo.", "palavras": [{"w": "Pronto.", "t": 0.0}, {"w": "A", "t": 0.72}, {"w": "pasta", "t": 0.88}, {"w": "virou", "t": 1.28}, {"w": "um", "t": 1.413}, {"w": "repositório,", "t": 1.52}, {"w": "e", "t": 2.36}, {"w": "o", "t": 2.44}, {"w": "Git", "t": 2.56}, {"w": "começa", "t": 2.92}, {"w": "a", "t": 3.16}, {"w": "observar", "t": 3.36}, {"w": "tudo.", "t": 3.76}], "audio": "cena_016.wav"}, {"inicio": 80.48, "dur": 3.92, "janela": 0.25, "texto": "Agora vem a parte que mais confunde: as três áreas do Git.", "palavras": [{"w": "Agora", "t": 0.0}, {"w": "vem", "t": 0.32}, {"w": "a", "t": 0.48}, {"w": "parte", "t": 0.68}, {"w": "que", "t": 0.88}, {"w": "mais", "t": 1.04}, {"w": "confunde:", "t": 1.28}, {"w": "as", "t": 2.16}, {"w": "três", "t": 2.4}, {"w": "áreas", "t": 2.8}, {"w": "do", "t": 3.08}, {"w": "Git.", "t": 3.2}], "audio": "cena_017.wav"}, {"inicio": 84.4, "dur": 4.16, "janela": 0.25, "texto": "A primeira é a pasta de trabalho, onde você edita os arquivos normalmente.", "palavras": [{"w": "A", "t": 0.0}, {"w": "primeira", "t": 0.16}, {"w": "é", "t": 0.64}, {"w": "a", "t": 0.773}, {"w": "pasta", "t": 0.88}, {"w": "de", "t": 1.2}, {"w": "trabalho,", "t": 1.32}, {"w": "onde", "t": 2.0}, {"w": "você", "t": 2.16}, {"w": "edita", "t": 2.48}, {"w": "os", "t": 2.693}, {"w": "arquivos", "t": 2.8}, {"w": "normalmente.", "t": 3.2}], "audio": "cena_018.wav"}, {"inicio": 88.56, "dur": 4.92, "janela": 0.25, "texto": "A segunda é a área de preparação, onde você escolhe o que vai entrar na próxima versão.", "palavras": [{"w": "A", "t": 0.0}, {"w": "segunda", "t": 0.16}, {"w": "é", "t": 0.72}, {"w": "a", "t": 0.8}, {"w": "área", "t": 0.88}, {"w": "de", "t": 1.12}, {"w": "preparação,", "t": 1.28}, {"w": "onde", "t": 2.24}, {"w": "você", "t": 2.4}, {"w": "escolhe", "t": 2.68}, {"w": "o", "t": 3.08}, {"w": "que", "t": 3.147}, {"w": "vai", "t": 3.2}, {"w": "entrar", "t": 3.36}, {"w": "na", "t": 3.68}, {"w": "próxima", "t": 3.8}, {"w": "versão.", "t": 4.16}], "audio": "cena_019.wav"}, {"inicio": 93.48, "dur": 4.2, "janela": 0.25, "texto": "A terceira é o repositório, onde as versões ficam guardadas de verdade.", "palavras": [{"w": "A", "t": 0.0}, {"w": "terceira", "t": 0.12}, {"w": "é", "t": 0.72}, {"w": "o", "t": 0.8}, {"w": "repositório,", "t": 0.92}, {"w": "onde", "t": 1.88}, {"w": "as", "t": 2.0}, {"w": "versões", "t": 2.12}, {"w": "ficam", "t": 2.52}, {"w": "guardadas", "t": 2.8}, {"w": "de", "t": 3.2}, {"w": "verdade.", "t": 3.32}], "audio": "cena_020.wav"}, {"inicio": 97.68, "dur": 3.92, "janela": 0.25, "texto": "O comando git status mostra em qual área cada arquivo está.", "palavras": [{"w": "O", "t": 0.0}, {"w": "comando", "t": 0.16}, {"w": "git", "t": 0.56}, {"w": "status", "t": 1.16}, {"w": "mostra", "t": 1.6}, {"w": "em", "t": 1.92}, {"w": "qual", "t": 2.12}, {"w": "área", "t": 2.32}, {"w": "cada", "t": 2.64}, {"w": "arquivo", "t": 2.88}, {"w": "está.", "t": 3.2}], "audio": "cena_021.wav"}, {"inicio": 101.6, "dur": 3.56, "janela": 0.25, "texto": "Arquivo em vermelho foi modificado, mas ainda não foi preparado.", "palavras": [{"w": "Arquivo", "t": 0.0}, {"w": "em", "t": 0.28}, {"w": "vermelho", "t": 0.4}, {"w": "foi", "t": 0.92}, {"w": "modificado,", "t": 1.12}, {"w": "mas", "t": 1.92}, {"w": "aind