wav"}, {"inicio": 36.88, "dur": 5.12, "janela": 0.25, "texto": "No código é igual: a mesma chamada muda de forma, dependendo do objeto real.", "palavras": [{"w": "No", "t": 0.0}, {"w": "código", "t": 0.16}, {"w": "é", "t": 0.52}, {"w": "igual:", "t": 0.64}, {"w": "a", "t": 1.24}, {"w": "mesma", "t": 1.36}, {"w": "chamada", "t": 1.68}, {"w": "muda", "t": 2.32}, {"w": "de", "t": 2.56}, {"w": "forma,", "t": 2.72}, {"w": "dependendo", "t": 3.36}, {"w": "do", "t": 3.76}, {"w": "objeto", "t": 3.84}, {"w": "real.", "t": 4.24}], "audio": "cena_007.wav"}, {"inicio": 42.0, "dur": 5.76, "janela": 0.25, "texto": "Primeiro, veja o código sem polimorfismo. Para cada inimigo, você pergunta qual é o tipo dele.", "palavras": [{"w": "Primeiro,", "t": 0.0}, {"w": "veja", "t": 0.56}, {"w": "o", "t": 0.8}, {"w": "código", "t": 0.88}, {"w": "sem", "t": 1.36}, {"w": "polimorfismo.", "t": 1.6}, {"w": "Para", "t": 2.72}, {"w": "cada", "t": 2.96}, {"w": "inimigo,", "t": 3.16}, {"w": "você", "t": 3.72}, {"w": "pergunta", "t": 4.0}, {"w": "qual", "t": 4.48}, {"w": "é", "t": 4.72}, {"w": "o", "t": 4.8}, {"w": "tipo", "t": 4.88}, {"w": "dele.", "t": 5.2}], "audio": "cena_008.wav"}, {"inicio": 47.76, "dur": 5.92, "janela": 0.25, "texto": "Se for aldeão, joga a foice. Se for motosserra, avança. Se for cultista, amaldiçoa.", "palavras": [{"w": "Se", "t": 0.0}, {"w": "for", "t": 0.16}, {"w": "aldeão,", "t": 0.32}, {"w": "joga", "t": 0.92}, {"w": "a", "t": 1.16}, {"w": "foice.", "t": 1.28}, {"w": "Se", "t": 1.88}, {"w": "for", "t": 2.0}, {"w": "motosserra,", "t": 2.16}, {"w": "avança.", "t": 2.88}, {"w": "Se", "t": 3.68}, {"w": "for", "t": 3.84}, {"w": "cultista,", "t": 4.08}, {"w": "amaldiçoa.", "t": 4.72}], "audio": "cena_009.wav"}, {"inicio": 53.68, "dur": 3.12, "janela": 0.25, "texto": "Agora imagine o jogo com 50 tipos de inimigos.", "palavras": [{"w": "Agora", "t": 0.0}, {"w": "imagine", "t": 0.347}, {"w": "o", "t": 0.68}, {"w": "jogo", "t": 0.76}, {"w": "com", "t": 1.04}, {"w": "50", "t": 1.28