.", "t": 4.08}], "mascote": "explicando", "titulo": "Luzes de conexão", "audio": "cena_037.wav"}, {"inicio": 216.16, "dur": 6.32, "janela": 0.25, "texto": "Imagine dois computadores na mesma rede local copiando um arquivo. Qual equipamento encaminha os quadros entre eles?", "palavras": [{"w": "Imagine", "t": 0.0}, {"w": "dois", "t": 0.48}, {"w": "computadores", "t": 0.72}, {"w": "na", "t": 1.36}, {"w": "mesma", "t": 1.52}, {"w": "rede", "t": 1.84}, {"w": "local", "t": 2.2}, {"w": "copiando", "t": 2.48}, {"w": "um", "t": 2.92}, {"w": "arquivo.", "t": 3.04}, {"w": "Qual", "t": 3.68}, {"w": "equipamento", "t": 3.84}, {"w": "encaminha", "t": 4.48}, {"w": "os", "t": 4.88}, {"w": "quadros", "t": 5.04}, {"w": "entre", "t": 5.48}, {"w": "eles?", "t": 5.68}], "mascote": "pensando", "titulo": "Desafio rápido", "audio": "cena_038.wav"}, {"inicio": 222.48, "dur": 5.6, "janela": 0.25, "texto": "Nesse exemplo, o switch faz a entrega local. O roteador entra quando é preciso sair para outra rede.", "palavras": [{"w": "Nesse", "t": 0.0}, {"w": "exemplo,", "t": 0.24}, {"w": "o", "t": 0.76}, {"w": "switch", "t": 0.88}, {"w": "faz", "t": 1.32}, {"w": "a", "t": 1.52}, {"w": "entrega", "t": 1.627}, {"w": "local.", "t": 1.92}, {"w": "O", "t": 2.56}, {"w": "roteador", "t": 2.72}, {"w": "entra", "t": 3.2}, {"w": "quando", "t": 3.48}, {"w": "é", "t": 3.64}, {"w": "preciso", "t": 3.76}, {"w": "sair", "t": 4.16}, {"w": "para", "t": 4.56}, {"w": "outra", "t": 4.72}, {"w": "rede.", "t": 5.04}], "mascote": "explicando", "titulo": "Resposta do desafio", "audio": "cena_039.wav"}, {"inicio": 228.08, "dur": 5.24, "janela": 0.25, "texto": "A impressora está na rede local. Para um site externo, o computador envia o pacote ao gateway.", "palavras": [{"w": "A", "t": 0.0}, {"w": "impressora", "t": 0.08}, {"w": "está", "t": 0.64}, {"w": "na", "t": 0.8}, {"w": "rede", "t": 0.96}, {"w": "local.", "t": 1.12}, {"w": "Para", "t": 1.76}, {"w": "um", "t": 1.92}, {"w": "site", "t": 2.12}, {"w": "externo,", "t": 2.