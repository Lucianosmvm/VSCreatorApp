": 3.6}, {"w": "conexão", "t": 3.76}, {"w": "falhar.", "t": 4.24}], "mascote": "explicando", "titulo": "Switch ou roteador?", "audio": "cena_005.wav"}, {"inicio": 33.2, "dur": 5.68, "janela": 0.25, "texto": "A rede local, ou LAN, conecta equipamentos próximos, como os de uma casa ou escritório.", "palavras": [{"w": "A", "t": 0.0}, {"w": "rede", "t": 0.16}, {"w": "local,", "t": 0.4}, {"w": "ou", "t": 1.04}, {"w": "LAN,", "t": 1.28}, {"w": "conecta", "t": 1.92}, {"w": "equipamentos", "t": 2.24}, {"w": "próximos,", "t": 2.88}, {"w": "como", "t": 3.6}, {"w": "os", "t": 3.72}, {"w": "de", "t": 3.84}, {"w": "uma", "t": 3.92}, {"w": "casa", "t": 4.16}, {"w": "ou", "t": 4.56}, {"w": "escritório.", "t": 4.72}], "mascote": "explicando", "titulo": "Rede local", "audio": "cena_006.wav"}, {"inicio": 38.88, "dur": 4.72, "janela": 0.25, "texto": "Ligue o computador ao switch com um cabo. Em outra porta, ligue a impressora.", "palavras": [{"w": "Ligue", "t": 0.0}, {"w": "o", "t": 0.267}, {"w": "computador", "t": 0.32}, {"w": "ao", "t": 0.84}, {"w": "switch", "t": 0.96}, {"w": "com", "t": 1.44}, {"w": "um", "t": 1.56}, {"w": "cabo.", "t": 1.68}, {"w": "Em", "t": 2.4}, {"w": "outra", "t": 2.6}, {"w": "porta,", "t": 2.88}, {"w": "ligue", "t": 3.44}, {"w": "a", "t": 3.653}, {"w": "impressora.", "t": 3.72}], "mascote": "apontando", "titulo": "Uma tomada de rede", "audio": "cena_007.wav"}, {"inicio": 43.6, "dur": 5.44, "janela": 0.25, "texto": "Ao mandar imprimir, o computador envia dados pelo cabo. O switch recebe esses dados.", "palavras": [{"w": "Ao", "t": 0.0}, {"w": "mandar", "t": 0.16}, {"w": "imprimir,", "t": 0.48}, {"w": "o", "t": 1.16}, {"w": "computador", "t": 1.28}, {"w": "envia", "t": 1.76}, {"w": "dados", "t": 2.08}, {"w": "pelo", "t": 2.44}, {"w": "cabo.", "t": 2.72}, {"w": "O", "t": 3.36}, {"w": "switch", "t": 3.52}, {"w": "recebe", "t": 4.12}, {"w": "esses", "t": 4.52}, {"w": "dados.", "t": 4.84}], "mascote": "apontando", "titulo": "O switch recebe", "audio": "cena_008.wav"}, {"inicio": 49.04, "dur": 7.28, "janela": 0.25, "texto": "O switch precisa decidir em qual porta entregar o quadro Ethernet. Para isso, ele consulta o endereço MAC de destino.", "palavras": [{"w": "O", "t": 0.0}, {"w": "switch", "t": 0.16}, {"w": "precisa", "t": 0.56}, {"w": "decidir", "t": 0.88}, {"w": "em", "t": 1.36}, {"w": "qual", "t": 1.6}, {"w": "porta", "t": 1.84}, {"w": "entregar", "t": 2.187}, {"w": "o", "t": 2.56}, {"w": "quadro", "t": 2.76}, {"w": "Ethernet.", "t": 2.96}, {"w": "Para", "t": 3.84}, {"w": "isso,", "t": 4.16}, {"w": "ele", "t": 4.72}, {"w": "consulta", "t": 4.88}, {"w": "o", "t": 5.32}, {"w": "endereço", "t": 5.44}, {"w": "MAC", "t": 5.92}, {"w": "de", "t": 6.28}, {"w": "destino.", "t": 6.4}], "mascote": "explicando", "titulo": "Para qual porta?", "audio": "cena_009.wav"}, {"inicio": 56.32, "dur": 5.6, "janela": 0.25, "texto": "O MAC identifica uma interface de rede no enlace. Pense nele como a etiqueta da entrega local.", "palavras": [{"w": "O", "t": 0.0}, {"w": "MAC", "t": 0.16}, {"w": "identifica", "t": 0.56}, {"w": "uma", "t": 1.08}, {"w": "interface", "t": 1.2}, {"w": "de", "t": 1.84}, {"w": "rede", "t": 2.0}, {"w": "no", "t": 2.24}, {"w": "enlace.", "t": 2.4}, {"w": "Pense", "t": 3.2}, {"w": "nele", "t": 3.52}, {"w": "como", "t": 3.84}, {"w": "a", "t": 3.96}, {"w": "etiqueta", "t": 4.08}, {"w": "da", "t": 4.6}, {"w": "entrega", "t": 4.72}, {"w": "local.", "t": 5.24}], "mascote": "explicando", "titulo": "Endereço MAC", "audio": "cena_010.wav"}, {"inicio": 61.92, "dur": 6.0, "janela": 0.25, "texto": "Quando recebe um quadro, o switch observa o MAC de origem e associa esse endereço à porta de entrada.", "palavras": [{"w": "Quando", "t": 0.0}, {"w": "recebe", "t": 0.36}, {"w": "um", "t": 0.64}, {"w": "quadro,", "t": 0.88}, {"w": "o", "t": 1.4}, {"w": "switch", "t": 1.52}, {"w": "observa", "t": 2.04}, {"w": "o", "t": 2.32}, {"w": "MAC", "t": 2.4}, {"w": "de", "t": 2.68}, {"w": "origem", "t": 2.8}, {"w": "e", "t": 3.32}, {"w": "associa",