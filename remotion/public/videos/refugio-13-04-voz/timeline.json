{"fps": 30, "largura": 1080, "altura": 1920, "duracao": 85.04, "projeto": {"id": "refugio-13-04-voz", "nome": "Refúgio 13 — Dia 04"}, "legenda": {"pos": 80, "estilo": "outline"}, "cenas": [{"inicio": 0.0, "dur": 5.04, "janela": 0.0, "texto": "Deu empate: um voto no mercado, um no rádio. Então o abrigo decidiu.", "palavras": [{"w": "Deu", "t": 0.0}, {"w": "empate:", "t": 0.24}, {"w": "um", "t": 1.12}, {"w": "voto", "t": 1.24}, {"w": "no", "t": 1.52}, {"w": "mercado,", "t": 1.6}, {"w": "um", "t": 2.4}, {"w": "no", "t": 2.52}, {"w": "rádio.", "t": 2.64}, {"w": "Então", "t": 3.44}, {"w": "o", "t": 3.76}, {"w": "abrigo", "t": 3.84}, {"w": "decidiu.", "t": 4.24}], "audio": "cena_000.wav"}, {"inicio": 5.04, "dur": 5.44, "janela": 0.0, "texto": "Velho Jiu bateu o pé: chamar no rádio só ia trazer mais gente, e dobrar os problemas.", "palavras": [{"w": "Velho", "t": 0.0}, {"w": "Jiu", "t": 0.28}, {"w": "bateu", "t": 0.52}, {"w": "o", "t": 0.76}, {"w": "pé:", "t": 0.88}, {"w": "chamar", "t": 1.52}, {"w": "no", "t": 1.84}, {"w": "rádio", "t": 2.0}, {"w": "só", "t": 2.32}, {"w": "ia", "t": 2.48}, {"w": "trazer", "t": 2.6}, {"w": "mais", "t": 2.96}, {"w": "gente,", "t": 3.2}, {"w": "e", "t": 3.72}, {"w": "dobrar", "t": 3.88}, {"w": "os", "t": 4.2}, {"w": "problemas.", "t": 4.32}], "audio": "cena_001.wav"}, {"inicio": 10.48, "dur": 5.28, "janela": 0.0, "texto": "Nilo, Eva e Velho Jiu foram ao mercado. Lia e Ulisses ficaram guardando a estação.", "palavras": [{"w": "Nilo,", "t": 0.0}, {"w": "Eva", "t": 0.56}, {"w": "e", "t": 0.84}, {"w": "Velho", "t": 0.96}, {"w": "Jiu", "t": 1.2}, {"w": "foram", "t": 1.52}, {"w": "ao", "t": 1.72}, {"w": "mercado.", "t": 1.92}, {"w": "Lia", "t": 2.72}, {"w": "e", "t": 3.0}, {"w": "Ulisses", "t": 3.12}, {"w": "ficaram", "t": 3.6}, {"w": "guardando", "t": 3.96}, {"w": "a", "t": 4.267}, {"w": "estação.", "t": 4.32}], "audio": "cena_002.wav"}, {"inicio": 15.76, "dur": 3.2, "janela": 0.0, "texto": "Eles seguiram pelo caminho dos trilhos, sem fazer barul