{"autoMeta":null,"frames":[{"id":"fmv7y2g4r-0","prompt":"","text":"Seu array não aceita mais nenhum item? Calma, não é bug.","narration":"","mascote":"cocando","titulo":"Array cheio?","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.313,0.662,0.824,1.219,1.44,1.741,2.183,2.554,2.705,2.786],"audioText":"Seu array não aceita mais nenhum item? Calma, não é bug.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmv7yaa31","hasVideo":false,"audioDur":3.251},{"id":"fmv7y2g4r-1","prompt":"","text":"O array tem tamanho fixo. Você define na criação, e ele nunca muda.","narration":"","mascote":"placa","placa":"ARRAY","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.18599999999999994,0.476,0.6499999999999999,1.0210000000000004,1.5320000000000005,1.823,2.182,2.299,2.9950000000000006,3.1460000000000004,3.32,3.6220000000000003],"audioText":"O array tem tamanho fixo. Você define na criação, e ele nunca muda.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmv7yaa31","hasVideo":false,"audioDur":4.075},{"id":"fmv7y2g4r-2","prompt":"","text":"Exemplo: string, colchetes, nomes igual a new string de 3. Pronto: três caixinhas vazias.","narration":"","mascote":"digitando","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.8240000000000007,1.3810000000000011,2.1480000000000006,2.484000000000001,2.7860000000000005,2.868000000000001,3.0420000000000007,3.402,3.553,3.971000000000001,4.505,4.8180000000000005,5.306],"audioText":"Exemplo: string, colchetes, nomes igual a new string de 3. Pronto: três caixinhas vazias.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmv7yaa31","hasVideo":false,"audioDur":6.084},{"id":"fmv7y2g4r-3","prompt":"","text":"Criou com 3 posições? S