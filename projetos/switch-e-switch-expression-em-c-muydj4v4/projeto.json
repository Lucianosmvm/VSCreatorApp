{"frames":[{"id":"fmuydj4v4-0","prompt":"","text":"Se o seu código tem uma pilha de else if comparando a mesma variável, existe um jeito muito mais limpo de escrever isso.","narration":"","mascote":"acenando","titulo":"Chega de else if","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.174,0.255,0.476,0.964,1.115,1.289,1.602,1.892,2.299,2.694,3.251,3.332,3.646,4.342,4.69,4.795,5.108,5.399,5.608,5.875,5.944,6.397],"audioText":"Se o seu código tem uma pilha de else if comparando a mesma variável, existe um jeito muito mais limpo de escrever isso.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmuydnm4n","hasVideo":false,"audioDur":6.745},{"id":"fmuydj4v4-1","prompt":"","text":"Hoje você vai aprender o switch clássico e a switch expression do C sharp moderno.","narration":"","mascote":"comemorando","titulo":"switch × switch expression","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.2560000000000002,0.5339999999999998,0.7089999999999996,1.1269999999999998,1.1959999999999997,1.556,2.1599999999999993,2.2879999999999994,2.3690000000000007,2.694,3.297999999999999,3.425,3.5989999999999993,3.9479999999999995],"audioText":"Hoje você vai aprender o switch clássico e a switch expression do C sharp moderno.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmuydnm4n","hasVideo":false,"audioDur":4.54},{"id":"fmuydj4v4-2","prompt":"","text":"E principalmente: quando usar cada um. Fica até o final que tem um desafio.","narration":"","mascote":"desconfiado","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.13899999999999935,0.9640000000000004,1.2300000000000004,1.4969999999999999,1.7639999999999993,1.9960000000000004,2.2750000000000004,2.484,2.542,2.8789999999999996,2.994999999999999,3.145999999999999,3.2270000000000003],"audioText