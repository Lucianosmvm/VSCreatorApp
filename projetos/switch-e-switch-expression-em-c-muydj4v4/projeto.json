ica vez e pula direto para o caso que combina com o valor.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmuydnm4n","hasVideo":false,"audioDur":4.877},{"id":"fmuydj4v4-8","prompt":"","text":"A estrutura é: a palavra switch, o valor entre parênteses, e um bloco de chaves.","narration":"","mascote":"lado","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.1039999999999992,0.6270000000000024,0.8590000000000018,0.9750000000000014,1.3350000000000009,1.8340000000000032,1.939,2.2750000000000057,2.507000000000005,3.1810000000000045,3.297000000000004,3.4010000000000034,3.703000000000003,3.8190000000000026],"audioText":"A estrutura é: a palavra switch, o valor entre parênteses, e um bloco de chaves.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmuydnm4n","hasVideo":false,"audioDur":4.2720416666666665},{"id":"fmuydj4v4-9","prompt":"","text":"Dentro dele, cada case representa um valor possível, seguido de dois pontos.","narration":"","mascote":"neutro","titulo":"case","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.3369999999999962,0.6389999999999958,0.9059999999999988,1.195999999999998,1.7069999999999936,1.7999999999999972,2.125,2.7169999999999987,3.134999999999998,3.2509999999999977,3.5060000000000002],"audioText":"Dentro dele, cada case representa um valor possível, seguido de dois pontos.","audioReqId":null,"audioReqAt":0,"audioVoice":"BY2YHOQTNuJ2oMUKv3Kg","audioModel":"eleven_multilingual_v2","audioFaixa":"fxmuydnm4n","hasVideo":false,"audioDur":3.982},{"id":"fmuydj4v4-10","prompt":"","text":"Depois do case vem o código que deve rodar, e no final, a palavra break.","narration":"","mascote":"frente","titulo":"break","enhanced":"","imageUrl":null,"hasImageBytes":false,"hasAudio":true,"wordTimes":[0,0.34899999999999665,0.4649999999999963,0.7779999999999